# EditorConfig — https://editorconfig.org
# Enforced in CI: when this file is present, lint-extras runs
# editorconfig-checker over every tracked file.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown may use trailing whitespace for hard line breaks.
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
